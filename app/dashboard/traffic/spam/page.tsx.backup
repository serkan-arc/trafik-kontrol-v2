'use client';

import { useState, useEffect } from 'react';

export default function SpamControlPage() {
  const [spamData, setSpamData] = useState<any>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    fetchSpamData();
  }, []);

  const fetchSpamData = async () => {
    try {
      const res = await fetch('/api/traffic/spam/summary');
      const data = await res.json();
      if (data.success) {
        setSpamData(data.data);
      }
    } catch (error) {
      console.error('Error fetching spam data:', error);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="space-y-6">
      <div>
        <h1 className="text-3xl font-bold text-gray-900">Spam Control</h1>
        <p className="text-gray-600 mt-2">Form spam tespiti ve önleme</p>
      </div>

      {loading ? (
        <div className="text-center py-12">
          <div className="text-xl">Spam verileri yükleniyor...</div>
        </div>
      ) : (
        <>
          {/* Stats Cards */}
          <div className="grid grid-cols-1 md:grid-cols-4 gap-6">
            <div className="bg-white rounded-lg shadow p-6">
              <div className="text-sm text-gray-600">Total Submissions</div>
              <div className="text-3xl font-bold text-gray-900 mt-2">
                {spamData?.summary?.total_submissions || 0}
              </div>
            </div>
            <div className="bg-red-50 rounded-lg shadow p-6">
              <div className="text-sm text-red-600">Spam Detected</div>
              <div className="text-3xl font-bold text-red-900 mt-2">
                {spamData?.summary?.spam_count || 0}
              </div>
            </div>
            <div className="bg-green-50 rounded-lg shadow p-6">
              <div className="text-sm text-green-600">Legitimate</div>
              <div className="text-3xl font-bold text-green-900 mt-2">
                {spamData?.summary?.legitimate_count || 0}
              </div>
            </div>
            <div className="bg-yellow-50 rounded-lg shadow p-6">
              <div className="text-sm text-yellow-600">Spam Rate</div>
              <div className="text-3xl font-bold text-yellow-900 mt-2">
                {spamData?.summary?.spam_rate || 0}%
              </div>
            </div>
          </div>

          {/* Detection Methods */}
          <div className="bg-white rounded-lg shadow p-6">
            <h2 className="text-xl font-semibold mb-4">Detection Methods</h2>
            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div className="border border-gray-200 rounded-lg p-4">
                <div className="text-lg font-semibold">⏱️ Time-based</div>
                <div className="text-sm text-gray-600 mt-2">
                  Detects forms filled in less than 3 seconds
                </div>
              </div>
              <div className="border border-gray-200 rounded-lg p-4">
                <div className="text-lg font-semibold">🔄 Duplicate Data</div>
                <div className="text-sm text-gray-600 mt-2">
                  SHA256 hash comparison for repeated submissions
                </div>
              </div>
              <div className="border border-gray-200 rounded-lg p-4">
                <div className="text-lg font-semibold">📊 Frequency Analysis</div>
                <div className="text-sm text-gray-600 mt-2">
                  3x/5x submissions in 24 hours trigger alerts
                </div>
              </div>
            </div>
          </div>

          {/* Recent Spam Detections */}
          <div className="bg-white rounded-lg shadow">
            <div className="p-6">
              <h2 className="text-xl font-semibold mb-4">Recent Spam Detections</h2>
              {!spamData?.recent_spam || spamData.recent_spam.length === 0 ? (
                <div className="text-center py-8 text-gray-500">
                  Henüz spam tespiti yapılmamış.
                </div>
              ) : (
                <div className="overflow-x-auto">
                  <table className="min-w-full">
                    <thead className="bg-gray-50">
                      <tr>
                        <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">IP</th>
                        <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Form</th>
                        <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Score</th>
                        <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Action</th>
                        <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-gray-200">
                      {spamData.recent_spam.map((spam: any) => (
                        <tr key={spam.id}>
                          <td className="px-6 py-4 text-sm">{spam.ip}</td>
                          <td className="px-6 py-4 text-sm">{spam.form_name}</td>
                          <td className="px-6 py-4 text-sm">
                            <span className={`px-2 py-1 rounded ${
                              spam.spam_score >= 80 ? 'bg-red-100 text-red-800' :
                              spam.spam_score >= 50 ? 'bg-yellow-100 text-yellow-800' :
                              'bg-green-100 text-green-800'
                            }`}>
                              {spam.spam_score}
                            </span>
                          </td>
                          <td className="px-6 py-4 text-sm">{spam.action}</td>
                          <td className="px-6 py-4 text-sm text-gray-500">
                            {new Date(spam.created_at).toLocaleString()}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </div>
        </>
      )}
    </div>
  );
}
