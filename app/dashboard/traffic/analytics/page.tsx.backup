'use client';

import { useState, useEffect } from 'react';

export default function AnalyticsPage() {
  const [timeRange, setTimeRange] = useState(7);
  const [analytics, setAnalytics] = useState<any>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    fetchAnalytics();
  }, [timeRange]);

  const fetchAnalytics = async () => {
    setLoading(true);
    try {
      const res = await fetch(`/api/traffic/analytics/dashboard?days=${timeRange}`);
      const data = await res.json();
      if (data.success) {
        setAnalytics(data.data);
      }
    } catch (error) {
      console.error('Error fetching analytics:', error);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="space-y-6">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-3xl font-bold text-gray-900">Traffic Analytics</h1>
          <p className="text-gray-600 mt-2">Detaylı trafik analizi ve raporlama</p>
        </div>
        <select 
          value={timeRange}
          onChange={(e) => setTimeRange(Number(e.target.value))}
          className="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500"
        >
          <option value={1}>Last 24 hours</option>
          <option value={7}>Last 7 days</option>
          <option value={30}>Last 30 days</option>
          <option value={90}>Last 90 days</option>
        </select>
      </div>

      {loading ? (
        <div className="text-center py-12">
          <div className="text-xl">Analytics yükleniyor...</div>
        </div>
      ) : (
        <>
          {/* Overview Stats */}
          <div className="grid grid-cols-1 md:grid-cols-4 gap-6">
            <div className="bg-white rounded-lg shadow p-6">
              <div className="text-sm text-gray-600">Total IPs</div>
              <div className="text-3xl font-bold text-gray-900 mt-2">
                {analytics?.overview?.total_ips || 0}
              </div>
            </div>
            <div className="bg-blue-50 rounded-lg shadow p-6">
              <div className="text-sm text-blue-600">Total Visits</div>
              <div className="text-3xl font-bold text-blue-900 mt-2">
                {analytics?.overview?.total_visits || 0}
              </div>
            </div>
            <div className="bg-green-50 rounded-lg shadow p-6">
              <div className="text-sm text-green-600">Clean IPs</div>
              <div className="text-3xl font-bold text-green-900 mt-2">
                {analytics?.overview?.clean_ips || 0}
              </div>
            </div>
            <div className="bg-red-50 rounded-lg shadow p-6">
              <div className="text-sm text-red-600">Blacklisted</div>
              <div className="text-3xl font-bold text-red-900 mt-2">
                {analytics?.overview?.blacklisted_ips || 0}
              </div>
            </div>
          </div>

          {/* Risk Distribution */}
          <div className="bg-white rounded-lg shadow p-6">
            <h2 className="text-xl font-semibold mb-4">Risk Level Distribution</h2>
            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div className="border border-gray-200 rounded-lg p-4">
                <div className="flex items-center justify-between">
                  <div>
                    <div className="text-sm text-gray-600">Low Risk (0-30)</div>
                    <div className="text-2xl font-bold text-green-600 mt-1">
                      {analytics?.risk_levels?.low_risk || 0}
                    </div>
                  </div>
                  <div className="text-4xl">🟢</div>
                </div>
              </div>
              <div className="border border-gray-200 rounded-lg p-4">
                <div className="flex items-center justify-between">
                  <div>
                    <div className="text-sm text-gray-600">Medium Risk (31-70)</div>
                    <div className="text-2xl font-bold text-yellow-600 mt-1">
                      {analytics?.risk_levels?.medium_risk || 0}
                    </div>
                  </div>
                  <div className="text-4xl">🟡</div>
                </div>
              </div>
              <div className="border border-gray-200 rounded-lg p-4">
                <div className="flex items-center justify-between">
                  <div>
                    <div className="text-sm text-gray-600">High Risk (71-100)</div>
                    <div className="text-2xl font-bold text-red-600 mt-1">
                      {analytics?.risk_levels?.high_risk || 0}
                    </div>
                  </div>
                  <div className="text-4xl">🔴</div>
                </div>
              </div>
            </div>
          </div>

          {/* Device Distribution */}
          <div className="bg-white rounded-lg shadow p-6">
            <h2 className="text-xl font-semibold mb-4">Device Distribution</h2>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div className="border border-gray-200 rounded-lg p-4">
                <div className="flex items-center justify-between">
                  <div>
                    <div className="text-sm text-gray-600">Desktop</div>
                    <div className="text-2xl font-bold text-gray-900 mt-1">
                      {analytics?.device_stats?.desktop || 0}
                    </div>
                  </div>
                  <div className="text-4xl">💻</div>
                </div>
              </div>
              <div className="border border-gray-200 rounded-lg p-4">
                <div className="flex items-center justify-between">
                  <div>
                    <div className="text-sm text-gray-600">Mobile</div>
                    <div className="text-2xl font-bold text-gray-900 mt-1">
                      {analytics?.device_stats?.mobile || 0}
                    </div>
                  </div>
                  <div className="text-4xl">📱</div>
                </div>
              </div>
            </div>
          </div>

          {/* Top Countries */}
          <div className="bg-white rounded-lg shadow p-6">
            <h2 className="text-xl font-semibold mb-4">Top Countries</h2>
            {analytics?.geographic_stats && analytics.geographic_stats.length > 0 ? (
              <div className="space-y-3">
                {analytics.geographic_stats.slice(0, 10).map((country: any, idx: number) => (
                  <div key={idx} className="flex items-center justify-between border-b border-gray-100 pb-2">
                    <div className="flex items-center gap-3">
                      <span className="text-lg">{country.country}</span>
                      <span className="text-sm text-gray-600">({country.ip_count} IPs)</span>
                    </div>
                    <div className="text-sm text-gray-500">
                      {country.total_visits} visits
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div className="text-center py-8 text-gray-500">
                No geographic data available
              </div>
            )}
          </div>
        </>
      )}
    </div>
  );
}
