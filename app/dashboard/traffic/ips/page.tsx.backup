'use client';

import { useEffect, useState } from 'react';

interface IP {
  ip: string;
  country?: string;
  device_type?: string;
  visit_count: number;
  form_submissions: number;
  risk_score: number;
  spam_score: number;
  bot_score: number;
  list_status: string;
  first_seen: string;
  last_seen: string;
}

export default function IPManagementPage() {
  const [ips, setIps] = useState<IP[]>([]);
  const [loading, setLoading] = useState(true);
  const [filters, setFilters] = useState({
    status: '',
    minRiskScore: '',
    country: '',
    page: 1,
    limit: 20,
  });
  const [totalPages, setTotalPages] = useState(1);

  useEffect(() => {
    fetchIPs();
  }, [filters]);

  const fetchIPs = async () => {
    setLoading(true);
    try {
      const params = new URLSearchParams();
      if (filters.status) params.append('status', filters.status);
      if (filters.minRiskScore) params.append('minRiskScore', filters.minRiskScore);
      if (filters.country) params.append('country', filters.country);
      params.append('page', filters.page.toString());
      params.append('limit', filters.limit.toString());

      const res = await fetch(`/api/traffic/ips?${params}`);
      const data = await res.json();
      
      if (data.success) {
        setIps(data.data.ips);
        setTotalPages(data.data.meta.totalPages);
      }
    } catch (error) {
      console.error('Failed to fetch IPs:', error);
    } finally {
      setLoading(false);
    }
  };

  const getRiskColor = (score: number) => {
    if (score >= 80) return 'text-red-600 bg-red-100';
    if (score >= 50) return 'text-orange-600 bg-orange-100';
    if (score >= 30) return 'text-yellow-600 bg-yellow-100';
    return 'text-green-600 bg-green-100';
  };

  const getListBadge = (status: string) => {
    const badges = {
      whitelist: 'bg-green-100 text-green-800',
      graylist: 'bg-yellow-100 text-yellow-800',
      blacklist: 'bg-red-100 text-red-800',
      unknown: 'bg-gray-100 text-gray-800',
    };
    return badges[status as keyof typeof badges] || badges.unknown;
  };

  return (
    <div className="p-6 space-y-6">
      {/* Header */}
      <div>
        <h1 className="text-3xl font-bold">IP Management</h1>
        <p className="text-gray-600 mt-1">Monitor and manage tracked IPs</p>
      </div>

      {/* Filters */}
      <div className="bg-white rounded-lg shadow p-4">
        <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-1">
              List Status
            </label>
            <select
              value={filters.status}
              onChange={(e) => setFilters({ ...filters, status: e.target.value, page: 1 })}
              className="w-full px-3 py-2 border rounded-lg"
            >
              <option value="">All</option>
              <option value="whitelist">Whitelist</option>
              <option value="graylist">Graylist</option>
              <option value="blacklist">Blacklist</option>
              <option value="unknown">Unknown</option>
            </select>
          </div>

          <div>
            <label className="block text-sm font-medium text-gray-700 mb-1">
              Min Risk Score
            </label>
            <input
              type="number"
              value={filters.minRiskScore}
              onChange={(e) => setFilters({ ...filters, minRiskScore: e.target.value, page: 1 })}
              placeholder="0-100"
              className="w-full px-3 py-2 border rounded-lg"
            />
          </div>

          <div>
            <label className="block text-sm font-medium text-gray-700 mb-1">
              Country
            </label>
            <input
              type="text"
              value={filters.country}
              onChange={(e) => setFilters({ ...filters, country: e.target.value, page: 1 })}
              placeholder="US, TR, etc."
              className="w-full px-3 py-2 border rounded-lg"
            />
          </div>

          <div className="flex items-end">
            <button
              onClick={() => setFilters({ status: '', minRiskScore: '', country: '', page: 1, limit: 20 })}
              className="w-full px-4 py-2 bg-gray-200 hover:bg-gray-300 rounded-lg"
            >
              Clear Filters
            </button>
          </div>
        </div>
      </div>

      {/* IP Table */}
      <div className="bg-white rounded-lg shadow overflow-hidden">
        {loading ? (
          <div className="p-8 text-center text-gray-600">Loading IPs...</div>
        ) : ips.length === 0 ? (
          <div className="p-8 text-center text-gray-600">No IPs found</div>
        ) : (
          <>
            <div className="overflow-x-auto">
              <table className="w-full">
                <thead className="bg-gray-50">
                  <tr>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">IP Address</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Country</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Device</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Visits</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Forms</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Risk</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-gray-200">
                  {ips.map((ip) => (
                    <tr key={ip.ip} className="hover:bg-gray-50">
                      <td className="px-6 py-4 whitespace-nowrap">
                        <div className="font-mono text-sm">{ip.ip}</div>
                        <div className="text-xs text-gray-500">
                          {new Date(ip.last_seen).toLocaleDateString()}
                        </div>
                      </td>
                      <td className="px-6 py-4 whitespace-nowrap">
                        <span className="text-sm">{ip.country || '-'}</span>
                      </td>
                      <td className="px-6 py-4 whitespace-nowrap">
                        <span className="text-sm">{ip.device_type || '-'}</span>
                      </td>
                      <td className="px-6 py-4 whitespace-nowrap text-sm">
                        {ip.visit_count}
                      </td>
                      <td className="px-6 py-4 whitespace-nowrap text-sm">
                        {ip.form_submissions}
                      </td>
                      <td className="px-6 py-4 whitespace-nowrap">
                        <span className={`px-2 py-1 rounded text-xs font-semibold ${getRiskColor(ip.risk_score)}`}>
                          {ip.risk_score}
                        </span>
                      </td>
                      <td className="px-6 py-4 whitespace-nowrap">
                        <span className={`px-2 py-1 rounded text-xs font-semibold ${getListBadge(ip.list_status)}`}>
                          {ip.list_status}
                        </span>
                      </td>
                      <td className="px-6 py-4 whitespace-nowrap text-sm">
                        <button className="text-blue-600 hover:text-blue-800">
                          View Details
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {/* Pagination */}
            <div className="bg-gray-50 px-6 py-3 flex items-center justify-between border-t">
              <div className="text-sm text-gray-700">
                Page {filters.page} of {totalPages}
              </div>
              <div className="flex gap-2">
                <button
                  onClick={() => setFilters({ ...filters, page: Math.max(1, filters.page - 1) })}
                  disabled={filters.page === 1}
                  className="px-4 py-2 border rounded-lg disabled:opacity-50 disabled:cursor-not-allowed hover:bg-gray-100"
                >
                  Previous
                </button>
                <button
                  onClick={() => setFilters({ ...filters, page: Math.min(totalPages, filters.page + 1) })}
                  disabled={filters.page === totalPages}
                  className="px-4 py-2 border rounded-lg disabled:opacity-50 disabled:cursor-not-allowed hover:bg-gray-100"
                >
                  Next
                </button>
              </div>
            </div>
          </>
        )}
      </div>

      {/* Summary Stats */}
      <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div className="bg-white rounded-lg shadow p-4">
          <div className="text-sm text-gray-600">Total IPs</div>
          <div className="text-2xl font-bold mt-1">{ips.length}</div>
        </div>
        <div className="bg-white rounded-lg shadow p-4">
          <div className="text-sm text-gray-600">High Risk (≥50)</div>
          <div className="text-2xl font-bold mt-1 text-orange-600">
            {ips.filter(ip => ip.risk_score >= 50).length}
          </div>
        </div>
        <div className="bg-white rounded-lg shadow p-4">
          <div className="text-sm text-gray-600">Critical (≥80)</div>
          <div className="text-2xl font-bold mt-1 text-red-600">
            {ips.filter(ip => ip.risk_score >= 80).length}
          </div>
        </div>
        <div className="bg-white rounded-lg shadow p-4">
          <div className="text-sm text-gray-600">Blacklisted</div>
          <div className="text-2xl font-bold mt-1 text-red-600">
            {ips.filter(ip => ip.list_status === 'blacklist').length}
          </div>
        </div>
      </div>
    </div>
  );
}
