'use client';

import { useState, useEffect } from 'react';

export default function BotDetectionPage() {
  const [bots, setBots] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [stats, setStats] = useState<any>(null);

  useEffect(() => {
    fetchBotData();
  }, []);

  const fetchBotData = async () => {
    try {
      const res = await fetch('/api/traffic/bots/summary');
      const data = await res.json();
      if (data.success) {
        setStats(data.data.summary);
        setBots(data.data.recent_bots || []);
      }
    } catch (error) {
      console.error('Error fetching bot data:', error);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="space-y-6">
      <div>
        <h1 className="text-3xl font-bold text-gray-900">Bot Detection</h1>
        <p className="text-gray-600 mt-2">DNS doğrulaması ile bot tespiti</p>
      </div>

      {loading ? (
        <div className="text-center py-12">
          <div className="text-xl">Bot verileri yükleniyor...</div>
        </div>
      ) : (
        <>
          {/* Stats Cards */}
          <div className="grid grid-cols-1 md:grid-cols-4 gap-6">
            <div className="bg-white rounded-lg shadow p-6">
              <div className="text-sm text-gray-600">Total Bot Visits</div>
              <div className="text-3xl font-bold text-gray-900 mt-2">
                {stats?.total_bot_visits || 0}
              </div>
            </div>
            <div className="bg-green-50 rounded-lg shadow p-6">
              <div className="text-sm text-green-600">Verified Bots</div>
              <div className="text-3xl font-bold text-green-900 mt-2">
                {stats?.verified_bots || 0}
              </div>
            </div>
            <div className="bg-red-50 rounded-lg shadow p-6">
              <div className="text-sm text-red-600">Fake Bots</div>
              <div className="text-3xl font-bold text-red-900 mt-2">
                {stats?.fake_bots || 0}
              </div>
            </div>
            <div className="bg-blue-50 rounded-lg shadow p-6">
              <div className="text-sm text-blue-600">Detection Rate</div>
              <div className="text-3xl font-bold text-blue-900 mt-2">
                {stats?.detection_rate || 0}%
              </div>
            </div>
          </div>

          {/* Recent Bots Table */}
          <div className="bg-white rounded-lg shadow">
            <div className="p-6">
              <h2 className="text-xl font-semibold mb-4">Son Bot Ziyaretleri</h2>
              {!Array.isArray(bots) || bots.length === 0 ? (
                <div className="text-center py-8 text-gray-500">
                  Henüz bot tespiti yapılmamış.
                </div>
              ) : (
                <div className="overflow-x-auto">
                  <table className="min-w-full">
                    <thead className="bg-gray-50">
                      <tr>
                        <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">IP Address</th>
                        <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Bot Type</th>
                        <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Verified</th>
                        <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Hostname</th>
                        <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-gray-200">
                      {bots.map((bot: any, idx: number) => (
                        <tr key={idx}>
                          <td className="px-6 py-4 text-sm">{bot.ip}</td>
                          <td className="px-6 py-4 text-sm">{bot.bot_type}</td>
                          <td className="px-6 py-4 text-sm">
                            {bot.is_verified ? '✅ Verified' : '❌ Fake'}
                          </td>
                          <td className="px-6 py-4 text-sm text-gray-500">{bot.hostname || '-'}</td>
                          <td className="px-6 py-4 text-sm text-gray-500">{new Date(bot.checked_at).toLocaleString()}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </div>
        </>
      )}
    </div>
  );
}
